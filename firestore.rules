rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && (request.auth.token.email == "mosinjonovjasurbek00@gmail.com");
    }

    // Anime collection
    match /anime/{document=**} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }
    // Specific match for comments to handle ownership
    match /anime/{animeId}/comments/{commentId} {
      allow read, get, list: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // News Items
    match /news_items/{document=**} {
      allow read, get, list: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    // Public Notifications
    match /public_notifications/{id} {
      allow read, list: if true;
      allow write: if isAdmin();
    }
  }
}

{
  "app-id": "uz.animem.desktop",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "23.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "animem-uz-wrapper",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=pulseaudio",
    "--socket=session-bus",
    "--share=network",
    "--device=all"
  ],
  "modules": [
    {
      "name": "animem-uz",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin",
        "cp -r * /app/bin/",
        "chmod +x /app/bin/animem-uz",
        "echo '#!/bin/sh' > /app/bin/animem-uz-wrapper",
        "echo 'exec /app/bin/animem-uz --no-sandbox --disable-dev-shm-usage --disable-gpu-sandbox \"$@\"' >> /app/bin/animem-uz-wrapper",
        "chmod +x /app/bin/animem-uz-wrapper"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "release/linux-unpacked"
        }
      ]
    }
  ]
}
